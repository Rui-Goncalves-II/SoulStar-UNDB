  m_Script: {fileID: 11500000, guid: 6bab6c5a06fd3e44a900efeb7035a4fc, type: 3}
  m_Name: QuizTrapiche
  m_EditorClassIdentifier: Assembly-CSharp::PerguntasQuiz
  perguntas:
  - enunciado: "O que significa a palavra \"trapiche\"? A) Um tipo de embarca\xE7\xE3o
      usada para transportar algod\xE3o B) Armaz\xE9ns constru\xEDdos perto do cais
      para guardar mercadorias do porto  C) Uma fortaleza militar constru\xEDda para
      defender a cidade"
    opcoes:
    - A
    - B
    - C
    indiceCorreto: 1
  - enunciado: "Qual produto impulsionou o grande momento do Trapiche no s\xE9culo
      XIX? A) O a\xE7\xFAcar B) O caf\xE9 C) O algod\xE3o "
    opcoes:
    - A
    - B
    - C
    indiceCorreto: 2
  - enunciado: "Por que os azulejos foram usados nas fachadas das constru\xE7\xF5es?
      A) Apenas para decorar e embelezar os casar\xF5es B) Para impermeabilizar e
      proteger as paredes do clima quente e \xFAmido  C) Para imitar o estilo das
      constru\xE7\xF5es da Europa"
    opcoes:
    - A
    - B
    - C
    indiceCorreto: 1
  acertosNecessarios: 2
