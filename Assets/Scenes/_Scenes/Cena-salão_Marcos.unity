  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "O Trapiche Santo \xC2ngelo testemunhou a transforma\xE7\xE3o de S\xE3o
    Lu\xEDs em um dos maiores entrepostos do Imp\xE9rio. Sua arquitetura robusta,
    projetada para suportar a intensa movimenta\xE7\xE3o de mercadorias, reflete
    a grandiosidade dos magnatas da \xE9poca. Hoje h\xE1 os vest\xEDgios de uma estrutura
    que definiu a identidade costeira da capital, servindo como elo vital entre as
    rotas mar\xEDtimas globais e a economia local."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
